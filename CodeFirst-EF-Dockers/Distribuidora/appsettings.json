{
  "ConnectionStrings": {
    "Distribuidora": "Server=(localdb)\\MSSQLLocalDB;Database=Distribuidora;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Startup": {
    "ApplyMigrations": true,
    "SeedData": true,
    "RunDemoQueries": true,
    "MaxStartupRetries": 5,
    "RetryDelaySeconds": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Information"
    }
  }
}
